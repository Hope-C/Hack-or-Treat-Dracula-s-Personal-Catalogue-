# Copy this file to .env and fill in your keys.

# Tripo3D API — required, generates the 3D models.
# Get your key at https://platform.tripo3d.ai/
TRIPO_API_KEY=your_tripo_api_key_here

# Google Gemini API — optional, used for background removal.
# Get your key at https://aistudio.google.com/
# If left empty, background removal is skipped and the original photo is used.
GEMINI_API_KEY=

# OpenAI API — optional, powers the catalogue's "Try it on".
# Get your key at https://platform.openai.com/api-keys (API billing is separate from ChatGPT Plus).
# If left empty, try-on is unavailable; everything else still works.
OPENAI_API_KEY=your_openai_api_key_here
# Image model for try-on (optional)
OPENAI_IMAGE_MODEL=gpt-image-2

# Server port (default: 8000)
PORT=8000
